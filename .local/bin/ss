#!/bin/sh
DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"
case "$1" in
  full) maim "$FILE" && xclip -selection clipboard -t image/png < "$FILE" ;;
  area) maim -s "$FILE" && xclip -selection clipboard -t image/png < "$FILE" ;;
  clip) maim -s | xclip -selection clipboard -t image/png ;;
esac
